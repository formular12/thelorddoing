# PostgreSQL connection string — replace placeholders with your deployment values.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?schema=public"

# Backend port
PORT=4000

# Frontend origin allowed to call the backend
CORS_ORIGIN="http://localhost:5173"

# Generate a strong, unique secret for production.
AUTH_TOKEN_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
